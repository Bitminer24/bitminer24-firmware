# BitMiner24 2.0 — Grundeinstellungen. Alles Weitere bleibt IDF-Default,
# damit Abweichungen bewusst und dokumentiert sind.

# 240 MHz, wie bei 1.x vermessen
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

# 16 MB Flash (LilyGO T-Display S3)
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y

# eigene Partitionstabelle mit OTA-Slots
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# Rollback: schlaegt der erste Boot nach einem OTA fehl, zurueck zum
# alten Image. Kern des Update-Service, deshalb von Anfang an an.
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# Konsole auf USB-Serial-JTAG (T-Display S3 haengt direkt am USB)
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# Release-Optimierung statt -Og; der Kernel selbst steht per Pragma auf -O3,
# aber alles drumherum (memcpy, FreeRTOS-Pfade) soll nicht Debug sein
CONFIG_COMPILER_OPTIMIZATION_PERF=y

# TLS-Zertifikate werden nach dem SNTP-Sync auch zeitlich geprueft.
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_FULL=y
CONFIG_MBEDTLS_HAVE_TIME_DATE=y

# Produktbetrieb: Der Supervisor aktiviert und fuettert den Task-Watchdog
# gezielt. Idle-Tasks bleiben draussen, weil SHA absichtlich dauernd rechnet.
CONFIG_ESP_TASK_WDT_INIT=n

# Absturzdiagnose: bei einem Panic wird ein auswertbarer Speicherauszug in
# die coredump-Partition geschrieben. Ohne das weiss man bei einem
# Kundengeraet nur, DASS es neu gestartet ist, nicht warum.
CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH=y
CONFIG_ESP_COREDUMP_DATA_FORMAT_ELF=y
CONFIG_ESP_COREDUMP_CHECKSUM_CRC32=y
CONFIG_ESP_COREDUMP_MAX_TASKS_NUM=32
